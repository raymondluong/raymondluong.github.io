{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@config": ["./src/config"],
      "@content/*": ["./src/content/*"],
      "@data/*": ["./src/data/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@types": ["./src/types"],
      "@utils/*": ["./src/utils/*"]
    },
    "jsx": "react-jsx"
  }
}
