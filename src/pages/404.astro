---
import { SITE } from '@config';
import Page from '@layouts/Page.astro';
---

<Page title={`404 | ${SITE.title}`}>
  <div class="not-found">
    <div class="meta">Error 404</div>
    <h1 class="not-found-title">Page not found</h1>
    <p class="not-found-body">
      ¯\_(ツ)_/¯ &nbsp;The page you’re looking for doesn’t exist. Try heading <a
        href="/">back home</a
      >.
    </p>
  </div>
</Page>

<style is:global>
  .not-found {
    padding: 24px 0 12px;
  }
  .not-found .meta {
    margin-bottom: 12px;
  }
  .not-found-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.6px;
    margin: 0 0 14px;
  }
  .not-found-body {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 22px;
    line-height: 1.4;
    color: var(--dim);
    margin: 0;
    max-width: 640px;
    text-wrap: pretty;
  }

  @media (max-width: 720px) {
    .not-found-title {
      font-size: 30px;
    }
    .not-found-body {
      font-size: 18px;
    }
  }
</style>
