---
import Layout from '@layouts/Layout.astro';
// import { getCollection } from 'astro:content';
// import getSortedPosts from '@utils/getSortedPosts';
// import slugify from '@utils/slugify';

// const posts = await getCollection('blog');
// const recentPosts = getSortedPosts(posts).slice(0, 3);

// const formatDate = (d: string | Date) =>
//   new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const COLS = 65;
const ROWS = 19;

function buildCourtCells() {
  const set = new Set<string>();
  const T = 1;
  const B = ROWS - 2;
  const L = 4;
  const R = COLS - 5;
  const SL = T + 2;
  const SR = B - 2;
  const SVL = L + Math.round((R - L) * 0.27);
  const SVR = R - Math.round((R - L) * 0.27);
  const NET = Math.round((L + R) / 2);
  const MID_R = Math.round((SL + SR) / 2);
  const hLine = (r: number, c0: number, c1: number) => {
    for (let c = c0; c <= c1; c++) set.add(r + ',' + c);
  };
  const vLine = (c: number, r0: number, r1: number) => {
    for (let r = r0; r <= r1; r++) set.add(r + ',' + c);
  };
  hLine(T, L, R);
  hLine(B, L, R);
  vLine(L, T, B);
  vLine(R, T, B);
  hLine(SL, L, R);
  hLine(SR, L, R);
  vLine(SVL, SL, SR);
  vLine(SVR, SL, SR);
  hLine(MID_R, SVL, SVR);
  set.add(MID_R + ',' + L);
  set.add(MID_R + ',' + R);
  for (let r = 0; r < ROWS; r++) set.add(r + ',' + NET);
  return set;
}

const courtCells = buildCourtCells();
const cellsHtml = Array.from({ length: ROWS * COLS }, (_, idx) => {
  const r = Math.floor(idx / COLS);
  const c = idx % COLS;
  return courtCells.has(r + ',' + c)
    ? '<div class="cell" data-on="1"></div>'
    : '<div class="cell"></div>';
}).join('');
---

