<style is:global>
  :root,
  [data-theme='light'] {
    --ink: #0b2545;
    --paper: #fbfaf6;
    --dim: #5a6a86;
    --rule: rgba(11, 37, 69, 0.15);
    --hero-bg: #ffffff;
    --cell-off: #f0ede4;
    --cell-on: #0b2545;
  }

  [data-theme='dark'] {
    --ink: #e8ecf2;
    --paper: #0d1421;
    --dim: #7e8aa3;
    --rule: rgba(232, 236, 242, 0.14);
    --hero-bg: #131b2c;
    --cell-off: #1c2638;
    --cell-on: #e8ecf2;
  }

  :root {
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'Inter', -apple-system, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  /* Override the existing base.css body styles so the homepage uses its own
     palette + typography. `html body` outweighs the layout's `body` rule. */
  html body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    display: block;
    min-height: 0;
    -webkit-font-smoothing: antialiased;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .page a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: border-color 0.18s ease;
  }
  .page a:hover {
    border-color: var(--ink);
  }

  .meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .page {
    max-width: 860px;
    margin: 0 auto;
    padding: 80px 48px 100px;
  }

  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 36px;
  }
  .masthead-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    letter-spacing: -0.6px;
    margin: 0;
  }

  .theme-toggle {
    background: transparent;
    border: none;
    color: var(--dim);
    width: 32px;
    height: 32px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 999px;
    transition: color 0.18s ease, background 0.18s ease;
    position: relative;
  }
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--rule);
  }
  .theme-toggle svg {
    width: 18px;
    height: 18px;
    display: none;
  }
  [data-theme-mode='auto'] #iconAuto,
  [data-theme-mode='light'] #iconSun,
  [data-theme-mode='dark'] #iconMoon {
    display: block;
  }
  .theme-toggle .tip {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 2px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  [data-theme-mode='auto'] .tip::before {
    content: 'Auto';
  }
  [data-theme-mode='light'] .tip::before {
    content: 'Light';
  }
  [data-theme-mode='dark'] .tip::before {
    content: 'Dark';
  }
  .theme-toggle:hover .tip,
  .theme-toggle:focus-visible .tip {
    opacity: 1;
    transform: translateY(0);
  }

  .lede {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 30px;
    line-height: 1.32;
    margin: 0 0 28px;
    max-width: 720px;
    letter-spacing: -0.4px;
    text-wrap: pretty;
  }

  .section {
    margin: 0 0 36px;
  }
  .section dd {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 140px 1fr;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    gap: 28px;
  }
  .row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .row dt {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    padding-top: 4px;
  }
  .row dd {
    font-size: 16px;
    line-height: 1.55;
  }
  .row dd p {
    margin: 0 0 8px;
  }
  .row dd p:last-child {
    margin-bottom: 0;
  }
  .row dd .item {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 4px 0;
  }
  .row dd .item .date {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
    white-space: nowrap;
  }
  .row dd a.arrow::after {
    content: ' ↗';
    font-family: var(--mono);
    color: var(--dim);
  }

  .foot {
    margin-top: 56px;
    display: flex;
    justify-content: end;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
  }

  .tokens {
    position: relative;
    height: 340px;
    margin: 0 0 44px;
    border: 1px solid var(--rule);
    background: var(--hero-bg);
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(var(--cols, 64), 1fr);
    grid-template-rows: repeat(var(--rows, 18), 1fr);
    gap: 2px;
    padding: 18px;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .tokens .cell {
    background: var(--cell-off);
    transition: background 0.35s ease;
    border-radius: 1px;
  }
  /* paints the court before the JS animation loop takes over the inline
     backgrounds; keeps the static court visible if JS is slow or disabled */
  .tokens .cell[data-on='1'] {
    background: var(--cell-on);
  }

  @media (max-width: 720px) {
    .page {
      padding: 48px 24px 72px;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 14px 0;
    }
    .tokens {
      height: 260px;
    }
    .lede {
      font-size: 22px;
    }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'theme';

    function readStoredTheme() {
      const v = localStorage.getItem(STORAGE_KEY);
      return v === 'light' || v === 'dark' ? v : 'auto';
    }

    let themeMode = readStoredTheme();

    function resolvedTheme() {
      if (themeMode === 'auto') {
        return matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      }
      return themeMode;
    }

    function applyTheme() {
      const root = document.documentElement;
      root.dataset.theme = resolvedTheme();
      root.dataset.themeMode = themeMode;
      paintIdle();
    }

    matchMedia('(prefers-color-scheme: dark)').addEventListener(
      'change',
      () => {
        if (themeMode === 'auto') applyTheme();
      },
    );

    document.getElementById('themeToggle').addEventListener('click', () => {
      const next = { auto: 'light', light: 'dark', dark: 'auto' };
      themeMode = next[themeMode] || 'auto';
      if (themeMode === 'auto') localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, themeMode);
      applyTheme();
    });

    // ─── Tennis court grid (cells pre-rendered server-side) ───
    const tokensEl = document.getElementById('tokens');
    const COLS = +tokensEl.dataset.cols;
    const ROWS = +tokensEl.dataset.rows;
    const tokenCells = Array.from(tokensEl.children);

    let mouseC = -100,
      mouseR = -100;
    let mouseActive = false;

    tokensEl.addEventListener('mousemove', (e) => {
      const rect = tokensEl.getBoundingClientRect();
      mouseC = ((e.clientX - rect.left) / rect.width) * COLS - 1;
      mouseR = ((e.clientY - rect.top) / rect.height) * ROWS - 1;
      mouseActive = true;
    });
    tokensEl.addEventListener('mouseleave', () => {
      mouseActive = false;
      setTimeout(paintIdle, 50);
    });

    function getCss(name) {
      return getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim();
    }

    function paintIdle() {
      const off = getCss('--cell-off');
      const on = getCss('--cell-on');
      for (let i = 0; i < tokenCells.length; i++) {
        const el = tokenCells[i];
        el.style.background = el.dataset.on === '1' ? on : off;
      }
    }

    function animateTokens() {
      if (!mouseActive) {
        requestAnimationFrame(animateTokens);
        return;
      }
      const off = getCss('--cell-off');
      const on = getCss('--cell-on');
      const theme = resolvedTheme();
      const ballCore = theme === 'dark' ? '#d6e85a' : '#c6d84a';
      const ballHalo = theme === 'dark' ? '#5a6a2a' : '#e4ecb0';
      const ballSeam = theme === 'dark' ? '#2a3242' : '#f7f5e8';

      for (let i = 0; i < tokenCells.length; i++) {
        const el = tokenCells[i];
        const r = (i / COLS) | 0;
        const c = i % COLS;
        const dx = c - mouseC,
          dy = r - mouseR;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const isCourt = el.dataset.on === '1';
        let bg;
        if (dist < 1.5) bg = ballCore;
        else if (dist < 3.0) bg = isCourt ? on : ballHalo;
        else if (dist < 5.0) bg = isCourt ? on : ballSeam;
        else bg = isCourt ? on : off;
        el.style.background = bg;
      }
      requestAnimationFrame(animateTokens);
    }
    animateTokens();

    applyTheme();
  })();
</script>
