---
import Page from '@layouts/Page.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, ogImage, date, tags } = post.data;
const { Content, remarkPluginFrontmatter } = await post.render();

const ogUrl = ogImage ? new URL(ogImage, Astro.url.origin).href : undefined;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Page title={title} description={description} ogImage={ogUrl}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <span>{formattedDate}</span>
        <span aria-hidden="true">·</span>
        <span>{remarkPluginFrontmatter.minutesRead}</span>
      </div>
    </header>

    <div class="post-body">
      <Content />
    </div>

    {
      tags?.length ? (
        <ul class="post-tags">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.toLowerCase()}`}>{tag.toLowerCase()}</a>
            </li>
          ))}
        </ul>
      ) : null
    }
  </article>
</Page>

<style is:global>
  .post-header {
    margin-bottom: 36px;
  }
  .post-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.6px;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .post-meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    display: flex;
    gap: 10px;
  }

  .post-body {
    font-size: 17px;
    line-height: 1.7;
  }
  .post-body > :first-child {
    margin-top: 0;
  }
  .post-body h2,
  .post-body h3,
  .post-body h4 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.3px;
    line-height: 1.25;
    margin: 40px 0 12px;
  }
  .post-body h2 {
    font-size: 26px;
  }
  .post-body h3 {
    font-size: 21px;
  }
  .post-body h4 {
    font-size: 18px;
  }
  .post-body p {
    margin: 0 0 18px;
  }
  .post-body ul,
  .post-body ol {
    padding-left: 22px;
    margin: 0 0 18px;
  }
  .post-body li {
    margin: 4px 0;
  }
  .post-body li > p {
    margin: 0;
  }
  .post-body a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: border-color 0.18s ease;
  }
  .post-body a:hover {
    border-color: var(--ink);
  }
  .post-body code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--cell-off);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .post-body pre {
    padding: 16px 18px;
    border-radius: 4px;
    overflow-x: auto;
    margin: 0 0 22px;
    font-size: 13.5px;
    line-height: 1.55;
    border: 1px solid var(--rule);
  }
  .post-body pre code {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  /* Pin code block bg to --cell-off in both themes — Vitesse's pure-white
     light bg fights the cream --paper, and we want code to feel calm.
     Note: Astro emits class="astro-code", not "shiki". */
  .post-body pre.astro-code {
    background-color: var(--cell-off) !important;
  }
  /* Dark mode: swap token colors to Shiki's emitted --shiki-dark vars. */
  [data-theme='dark'] .post-body .astro-code,
  [data-theme='dark'] .post-body .astro-code span {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
  .post-body blockquote {
    margin: 0 0 22px;
    padding: 4px 0 4px 18px;
    border-left: 2px solid var(--rule);
    color: var(--dim);
    font-style: italic;
  }
  .post-body blockquote p:last-child {
    margin-bottom: 0;
  }
  .post-body img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 2px;
    margin: 12px 0;
  }
  .post-body hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 32px 0;
  }
  .post-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 22px;
    font-size: 15px;
  }
  .post-body th,
  .post-body td {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule);
  }
  .post-body th {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
  }

  .post-tags {
    list-style: none;
    padding: 20px 0 0;
    margin: 56px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid var(--rule);
  }
  .post-tags li {
    margin: 0;
  }
  .page .post-tags li a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--dim);
    padding: 4px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .page .post-tags li a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (max-width: 720px) {
    .post-title {
      font-size: 30px;
    }
    .post-body {
      font-size: 16px;
    }
    .post-body h2 {
      font-size: 22px;
    }
    .post-body h3 {
      font-size: 19px;
    }
  }
</style>
